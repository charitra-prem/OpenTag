new file mode 100644
index 0000000..8e91b7d
--- /dev/null
+++ b/packages/bot-slack/src/tool-log.ts
@@ -0,0 +1,409 @@
+import type { WebClient } from "@slack/web-api";
+import type { KnownBlock, MessageMetadataEventPayloadObject } from "@slack/types";
+
+/**
+ * A collapsible per-turn tool-call log (`toolStatusStyle: "collapsible"`).
+ *
+ * Instead of one status row per tool call, the whole turn gets ONE message:
+ * collapsed by default to a single line — `⚙️ N steps · <what's happening>` —
+ * with a `Show steps` button that expands it in place to the full appended
+ * history (and back). The "what's happening" line is written by a small model
+ * (Anthropic API, `CK_TOOL_LOG_MODEL`, key from `ANTHROPIC_API_KEY`) from the
+ * tool-call history; without a key it falls back to the latest step.
+ *
+ * The expand/collapse click is handled adapter-locally (like the feedback
+ * row): the adapter keeps a ts → ToolLog registry for live logs and can
+ * reconstruct one from the message's own metadata after a restart.
+ */
+
+export const TOOL_LOG_TOGGLE_ACTION_ID = "ck_tool_log_toggle";
+const METADATA_EVENT_TYPE = "ck_tool_log";
+
+/** Cap what we render/persist so blocks and metadata stay inside Slack limits. */
+const MAX_ROWS = 60;
+const MAX_HINT = 48;
+const MAX_SECTION_CHARS = 2800;
+/** Minimum gap between summarizer calls — tool bursts shouldn't stampede it. */
+const SUMMARY_MIN_INTERVAL_MS = 4_000;
+
+/**
+ * Live "Working…" header animation. A self-driven tick advances a spinner and a
+ * running clock so the message visibly *moves* for the whole turn — including
+ * the long thinking / tool-execution gaps where NO AG-UI events arrive (from
+ * Slack's side those are indistinguishable from real work, so we must NOT gate
+ * the animation on event activity: doing so freezes the spinner exactly when
+ * the agent is busy but quiet). The tick runs unconditionally until the turn
+ * ends; `finishTurn()` stops it. A stream that dies WITHOUT a turn-end is caught
+ * by the watchdog (dead-session alert), not by this widget.
+ *
+ * ~2s cadence is the practical floor: Slack rate-limits chat.update to roughly
+ * 1 edit/sec per message, so a message-body spinner is inherently stepped, not
+ * fluid — fluid motion is only possible via Slack's streaming API (used for the
+ * reply text), which a Block Kit button message can't use.
+ */
+const SPINNER = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
+const HEARTBEAT_MS = 2_000;
+
+const fmtElapsed = (secs: number): string =>
+  secs < 60
+    ? `${secs}s`
+    : `${Math.floor(secs / 60)}m ${String(secs % 60).padStart(2, "0")}s`;
+
+export interface ToolLogRow {
+  /** AG-UI toolCallId (dedup key). */
+  id: string;
+  /** Pretty display name, plain text (e.g. "Read", "linear:get_issue"). */
+  label: string;
+  /** Compact arg hint (path basename / command / query). */
+  hint: string;
+  done: boolean;
+}
+
+/** Args that add nothing when shown ("true", "echo ok" heartbeats, …). */
+const isJunkHint = (h: string): boolean =>
+  h.length < 3 || /^(true|false|ok|yes|echo ok|echo waiting.*|\.)$/i.test(h);
+
+/**
+ * A human phrase for "what the agent is doing", from its latest meaningful
+ * step — the no-API-key fallback for the collapsed summary line.
+ */
+function humanize(row: ToolLogRow): string {
+  const name = row.label.toLowerCase();
+  const hint = isJunkHint(row.hint) ? "" : row.hint;
+  const withHint = (verb: string): string => (hint ? `${verb} ${hint}` : verb);
+  if (name === "read") return withHint("reading");
+  if (name === "write") return withHint("writing");
+  if (name === "edit" || name === "multiedit" || name === "notebookedit")
+    return withHint("editing");
+  if (name === "bash") return hint ? `running ${hint}` : "running a command";
+  if (name === "grep" || name === "glob") return withHint("searching for");
+  if (name === "ls") return withHint("listing");
+  if (name === "webfetch" || name === "websearch") return withHint("browsing");
+  if (name === "task" || name === "agent") return "delegating to a subagent";
+  if (name === "todowrite" || name === "taskcreate" || name === "taskupdate")
+    return "updating its task list";
+  if (name === "skill") return withHint("using the skill");
+  if (name.includes(":")) return withHint(`calling ${row.label}`);
+  return withHint(`using ${row.label}`);
+}
+
+interface PersistedLog {
+  r: Array<{ l: string; h: string; d: boolean }>;
+  s: string;
+  e: boolean;
+  f: boolean;
+}
+
+/** One-line "what is the agent doing" from the tool history, via a small model. */
+async function llmSummary(rows: ToolLogRow[]): Promise<string | undefined> {
+  const key = process.env["ANTHROPIC_API_KEY"];
+  if (!key) return undefined;
+  const model = process.env["CK_TOOL_LOG_MODEL"] ?? "claude-haiku-4-5-20251001";
+  const recent = rows.slice(-20);
+  const body = {
+    model,
+    max_tokens: 40,
+    system:
+      "You narrate an AI coding agent's progress as a chat status line. " +
+      "Given its tool calls so far (oldest first), reply with ONE present-tense " +
+      "line, at most 12 words, describing what it is doing right now. " +
+      "No quotes, no trailing period.",
+    messages: [
+      {
+        role: "user",
+        content: recent
+          .map((r) => `- ${r.label}${r.hint ? ` · ${r.hint}` : ""}`)
+          .join("\n"),
+      },
+    ],
+  };
+  const ctrl = new AbortController();
+  const timer = setTimeout(() => ctrl.abort(), 6_000);
+  try {
+    const res = await fetch("https://api.anthropic.com/v1/messages", {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        "x-api-key": key,
+        "anthropic-version": "2023-06-01",
+      },
+      body: JSON.stringify(body),
+      signal: ctrl.signal,
+    });
+    if (!res.ok) return undefined;
+    const data = (await res.json()) as {
+      content?: Array<{ type: string; text?: string }>;
+    };
+    const text = data.content?.find((c) => c.type === "text")?.text?.trim();
+    return text ? text.replace(/\s+/g, " ").slice(0, 120) : undefined;
+  } catch {
+    return undefined;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export class ToolLog {
+  private rows: ToolLogRow[] = [];
+  private ts: string | undefined;
+  private expanded = false;
+  private finished = false;
+  private summary = "";
+  /** Serializes post/update calls; also coalesces bursts (one pending render). */
+  private chain: Promise<void> = Promise.resolve();
+  private renderQueued = false;
+  private summaryInFlight = false;
+  private summaryDirty = false;
+  private lastSummaryAt = 0;
+  /** Heartbeat animation state (live "Working…" header). */
+  private startedAt = Date.now();
+  private frame = 0;
+  private heartbeat: ReturnType<typeof setInterval> | undefined;
+
+  constructor(
+    private readonly opts: {
+      client: WebClient;
+      channel: string;
+      threadTs?: string;
+      /** ts → log map the adapter routes toggle clicks through. */
+      registry?: Map<string, ToolLog>;
+    },
+  ) {}
+
+  /** Rebuild a toggle-able log from a message's own metadata (post-restart). */
+  static fromPersisted(
+    opts: { client: WebClient; channel: string; ts: string; registry?: Map<string, ToolLog> },
+    payload: unknown,
+  ): ToolLog | undefined {
+    const p = payload as PersistedLog | undefined;
+    if (!p || !Array.isArray(p.r)) return undefined;
+    const log = new ToolLog(opts);
+    log.ts = opts.ts;
+    log.rows = p.r.map((r, i) => ({ id: `p${i}`, label: r.l, hint: r.h, done: r.d }));
+    log.summary = p.s ?? "";
+    log.expanded = Boolean(p.e);
+    log.finished = Boolean(p.f);
+    opts.registry?.set(opts.ts, log);
+    return log;
+  }
+
+  start(id: string, label: string): void {
+    if (this.finished) return;
+    const existing = this.rows.find((r) => r.id === id);
+    if (existing) existing.label = label;
+    else this.rows.push({ id, label, hint: "", done: false });
+    this.ping();
+    this.scheduleRender();
+  }
+
+  complete(id: string, label: string, hint: string): void {
+    if (this.finished) return;
+    const h = hint.length > MAX_HINT ? hint.slice(0, MAX_HINT - 1) + "…" : hint;
+    const existing = this.rows.find((r) => r.id === id);
+    if (existing) {
+      existing.label = label;
+      existing.hint = h;
+      existing.done = true;
+    } else {
+      this.rows.push({ id, label, hint: h, done: true });
+    }
+    this.ping();
+    this.scheduleRender();
+    this.scheduleSummary();
+  }
+
+  /**
+   * Ensure the header heartbeat is ticking. Called on tool events and (from the
+   * renderer) on text deltas — but the animation runs on its own timer, so this
+   * is only about *starting* it, not feeding it activity.
+   */
+  ping(): void {
+    this.ensureHeartbeat();
+  }
+
+  private ensureHeartbeat(): void {
+    if (this.heartbeat || this.finished) return;
+    this.heartbeat = setInterval(() => {
+      if (this.finished) return this.stopHeartbeat();
+      // Advance unconditionally: the agent is working for the whole turn,
+      // including the event-silent thinking/tool-exec gaps. Only finishTurn()
+      // stops the animation.
+      this.frame = (this.frame + 1) % SPINNER.length;
+      this.scheduleRender();
+    }, HEARTBEAT_MS);
+    // Never keep the process alive just for the animation.
+    (this.heartbeat as { unref?: () => void }).unref?.();
+  }
+
+  private stopHeartbeat(): void {
+    if (this.heartbeat) {
+      clearInterval(this.heartbeat);
+      this.heartbeat = undefined;
+    }
+  }
+
+  /** Turn over — freeze the log with a final summary (button keeps working). */
+  async finishTurn(): Promise<void> {
+    if (this.finished || this.rows.length === 0) return;
+    this.finished = true;
+    this.stopHeartbeat();
+    const s = await llmSummary(this.rows);
+    if (s) this.summary = s;
+    this.scheduleRender();
+    await this.chain;
+  }
+
+  /** Flip expanded/collapsed (adapter click handler). */
+  toggle(): void {
+    this.expanded = !this.expanded;
+    this.scheduleRender();
+  }
+
+  // ── Rendering ────────────────────────────────────────────────────────
+
+  private heuristicSummary(): string {
+    // Prefer the newest step whose arg means something to a human.
+    const rev = [...this.rows].reverse();
+    const last = rev.find((r) => !isJunkHint(r.hint)) ?? rev[0];
+    return last ? humanize(last) : "";
+  }
+
+  private headerLine(): string {
+    const n = this.rows.length;
+    const steps = `${n} step${n === 1 ? "" : "s"}`;
+    const what = this.summary || this.heuristicSummary();
+    const tail = what ? `  ·  _${what}_` : "";
+    if (this.finished) return `*Worked — ${steps}*${tail}`;
+    // Live: animated spinner + a running clock so the header visibly moves for
+    // the whole turn (see the SPINNER doc comment for why it's ungated).
+    const spin = SPINNER[this.frame];
+    const elapsed = Math.round((Date.now() - this.startedAt) / 1000);
+    const clock = elapsed >= 1 ? `  _(${fmtElapsed(elapsed)})_` : "";
+    return `${spin}  *Working…*  ${steps}${tail}${clock}`;
+  }
+
+  private buildBlocks(): { blocks: KnownBlock[]; text: string } {
+    const blocks: KnownBlock[] = [
+      { type: "section", text: { type: "mrkdwn", text: this.headerLine() } },
+    ];
+    if (this.expanded) {
+      const shown = this.rows.slice(-MAX_ROWS);
+      const hidden = this.rows.length - shown.length;
+      // Rows render as small muted context text — no emoji, no code chips.
+      const lines = shown.map((r) => {
+        const hint = isJunkHint(r.hint) ? "" : r.hint;
+        const line = `${r.label}${hint ? `  ·  ${hint}` : ""}`;
+        return r.done ? line : `_${line} …_`;
+      });
+      if (hidden > 0) lines.unshift(`_…${hidden} earlier steps hidden_`);
+      let buf = "";
+      const flush = () => {
+        if (!buf) return;
+        blocks.push({
+          type: "context",
+          elements: [{ type: "mrkdwn", text: buf }],
+        });
+        buf = "";
+      };
+      for (const line of lines) {
+        if (buf.length + line.length + 1 > MAX_SECTION_CHARS) flush();
+        buf += (buf ? "\n" : "") + line;
+      }
+      flush();
+    }
+    blocks.push({
+      type: "actions",
+      elements: [
+        {
+          type: "button",
+          action_id: TOOL_LOG_TOGGLE_ACTION_ID,
+          text: {
+            type: "plain_text",
+            text: this.expanded ? "Hide steps" : `Show steps (${this.rows.length})`,
+          },
+        },
+      ],
+    });
+    return { blocks, text: this.headerLine().replace(/[*_`]/g, "") };
+  }
+
+  private persistedPayload(): PersistedLog {
+    return {
+      r: this.rows.slice(-MAX_ROWS).map((r) => ({ l: r.label, h: r.hint, d: r.done })),
+      s: this.summary,
+      e: this.expanded,
+      f: this.finished,
+    };
+  }
+
+  private scheduleRender(): void {
+    if (this.renderQueued) return;
+    this.renderQueued = true;
+    this.chain = this.chain
+      .then(() => {
+        this.renderQueued = false;
+        return this.doRender();
+      })
+      .catch((err) => {
+        console.error("[slack-tool-log] render failed:", err);
+      });
+  }
+
+  private async doRender(): Promise<void> {
+    const { blocks, text } = this.buildBlocks();
+    const metadata = {
+      event_type: METADATA_EVENT_TYPE,
+      event_payload:
+        this.persistedPayload() as unknown as MessageMetadataEventPayloadObject,
+    };
+    if (!this.ts) {
+      const posted = await this.opts.client.chat.postMessage({
+        channel: this.opts.channel,
+        thread_ts: this.opts.threadTs,
+        blocks,
+        text,
+        metadata,
+      });
+      if (posted.ts) {
+        this.ts = posted.ts;
+        this.opts.registry?.set(posted.ts, this);
+      }
+      return;
+    }
+    await this.opts.client.chat.update({
+      channel: this.opts.channel,
+      ts: this.ts,
+      blocks,
+      text,
+      metadata,
+    });
+  }
+
+  // ── Summaries ────────────────────────────────────────────────────────
+
+  private scheduleSummary(): void {
+    if (this.finished) return;
+    if (this.summaryInFlight) {
+      this.summaryDirty = true;
+      return;
+    }
+    const since = Date.now() - this.lastSummaryAt;
+    const delay = Math.max(0, SUMMARY_MIN_INTERVAL_MS - since);
+    this.summaryInFlight = true;
+    setTimeout(() => {
+      void (async () => {
+        this.lastSummaryAt = Date.now();
+        const s = await llmSummary(this.rows);
+        this.summaryInFlight = false;
+        if (s && s !== this.summary && !this.finished) {
+          this.summary = s;
+          this.scheduleRender();
+        }
+        if (this.summaryDirty) {
+          this.summaryDirty = false;
+          this.scheduleSummary();
+        }
+      })();
+    }, delay);
+  }
+}
