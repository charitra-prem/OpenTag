[Unit]
Description=Omnigent server (native Claude/Codex session host, :6767)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omni
WorkingDirectory=/home/omni
Environment=PATH=/home/omni/.local/bin:/home/omni/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/omni/.local/bin/omnigent server --host 127.0.0.1 --port 6767 --database-uri sqlite:////home/omni/.omnigent/chat.db --artifact-location /home/omni/.omnigent/artifacts
Restart=always
RestartSec=5
StandardOutput=append:/home/omni/runtime.log
StandardError=append:/home/omni/runtime.log

[Install]
WantedBy=multi-user.target
