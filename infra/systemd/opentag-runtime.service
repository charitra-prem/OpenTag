[Unit]
Description=OpenTag legacy AG-UI triage runtime (:8200, used when AGENT_URL is set)
After=network-online.target

[Service]
Type=simple
User=omni
WorkingDirectory=/home/omni/OpenTag
Environment=PATH=/home/omni/.local/bin:/home/omni/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/omni/.bun/bin/bun run runtime
Restart=always
RestartSec=5
MemoryHigh=1024M
StandardOutput=append:/home/omni/runtime.log
StandardError=append:/home/omni/runtime.log

[Install]
WantedBy=multi-user.target
