{
  "name": "opentag",
  "version": "0.2.0",
  "private": true,
  "description": "OpenTag \u2014 an open-source, self-hosted alternative to Claude in Slack: run your own AI agent on your infrastructure, with your model and your tools. Built on @copilotkit/bot; also runs on Discord, Telegram & WhatsApp.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "vendor/copilotkit/packages/bot",
    "vendor/copilotkit/packages/bot-ui",
    "vendor/copilotkit/packages/bot-slack",
    "vendor/copilotkit/packages/bot-discord",
    "vendor/copilotkit/packages/bot-telegram",
    "vendor/copilotkit/packages/bot-whatsapp",
    "vendor/copilotkit/packages/core",
    "vendor/copilotkit/packages/shared",
    "vendor/copilotkit/packages/runtime",
    "vendor/copilotkit/packages/typescript-config",
    "vendor/copilotkit/packages/tsconfig"
  ],
  "scripts": {
    "dev": "tsx watch app/index.ts",
    "start": "tsx app/index.ts",
    "runtime": "tsx runtime.ts",
    "notion-mcp": "tsx scripts/start-notion-mcp.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "vendor:build": "bash scripts/build-copilotkit.sh",
    "vendor:sync": "bash scripts/sync-copilotkit.sh",
    "test": "vitest run",
    "e2e": "tsx e2e/run.ts",
    "e2e:restart": "tsx e2e/restart-recovery.ts",
    "e2e:telegram": "tsx e2e/telegram-run.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "rxjs": "7.8.1",
    "@copilotkit/bot": "workspace:*",
    "@copilotkit/bot-discord": "workspace:*",
    "@copilotkit/bot-slack": "workspace:*",
    "@copilotkit/bot-telegram": "workspace:*",
    "@copilotkit/bot-ui": "workspace:*",
    "@copilotkit/bot-whatsapp": "workspace:*",
    "@copilotkit/runtime": "workspace:*",
    "@tanstack/ai": "^0.32.0",
    "@tanstack/ai-mcp": "^0.1.3",
    "@tanstack/ai-openai": "^0.15.2",
    "@slack/bolt": "^4.2.0",
    "@slack/types": "^2.21.1",
    "playwright": "^1.49.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "rxjs": "7.8.1",
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57"
  },
  "devDependencies": {
    "@notionhq/notion-mcp-server": "^2.2.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.3"
  }
}
