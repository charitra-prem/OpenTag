# Set SLACK_*, DISCORD_*, and/or TELEGRAM_BOT_TOKEN — the bot starts an adapter
# for each platform whose secrets are present (any one, or several at once).
#
# By default, @mentions are answered by a NATIVE Claude Code / Codex session
# driven through Omnigent (see the "Omnigent" block below) — on your own
# subscription, no per-token API key needed. The legacy AG-UI agent backend
# (runtime.ts + Linear/Notion) is optional and OFF unless AGENT_URL is set.

# ── Slack credentials (from api.slack.com/apps → your app) ──────────────
# Set both to run on Slack; leave blank to skip Slack.
# Bot Token: OAuth & Permissions page, "Bot User OAuth Token" (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token: Basic Information → App-Level Tokens → generate with the
# "connections:write" scope (xapp-...)
SLACK_APP_TOKEN=xapp-...

# ── Omnigent (native Claude Code / Codex — the default mention backend) ──
# @mentions run a persistent native session per Slack thread via the local
# `omnigent` CLI. Nothing here is a secret: the harness authenticates with your
# own Claude/Codex login on the machine (`omnigent claude` / `codex login`).
# The omnigent server URL (the local server started by `omnigent server`).
OMNIGENT_URL=http://127.0.0.1:6767
# Working directory for plain-chat sessions — e.g. the parent directory of
# your repo clones (workflow phases override this with a per-issue worktree).
OMNIGENT_REPO=/home/omni/repos
# The `omnigent` CLI binary (override if it's not on PATH as "omnigent").
# OMNIGENT_BIN=omnigent
# Default harness when a turn carries no inline directive: claude | codex.
# Per-channel `/codex` `/claude` (or `@bot use codex`) override this at runtime;
# an inline `!codex <task>` overrides it for a single message.
OMNIGENT_EXECUTOR=claude
# Auto-approval launch args per harness (override only if the defaults change):
#   claude → --dangerously-skip-permissions
#   codex  → --dangerously-bypass-approvals-and-sandbox
# OMNIGENT_CLAUDE_ARGS=--dangerously-skip-permissions
# OMNIGENT_CODEX_ARGS=--dangerously-bypass-approvals-and-sandbox

# ── Issue workflow (plan → approve → implement) ────────────────────────────────
# `@bot take this` in a Linear-filed bug thread plans the fix, posts it for
# approval, and implements it in a per-issue git worktree after approval.
# Where the target repo clones live (one directory per repo).
# OPENTAG_REPOS_DIR=/home/omni/repos
# Where per-issue worktrees are created (<dir>/<ISSUE>/<repo>).
# OPENTAG_WORKTREES_DIR=/home/omni/worktrees
# Branch PRs target and worktrees are cut from (origin/<base>).
# OPENTAG_BASE_BRANCH=dev
# Where workflow state (workflows.json) persists across restarts.
# OPENTAG_STATE_DIR=~/.opentag
# Slack channel id the watchdog (infra/watchdog) posts health reports to —
# dead sessions, low memory, pane GC. Unset = watchdog logs to stdout only.
# OPENTAG_OPS_CHANNEL=
# Hours a workflow must sit done/failed/skipped before the watchdog reclaims
# its worktrees, local branches, and instance (open PRs are always spared).
# OPENTAG_DEBRIS_TTL_HOURS=6
# Harness per phase. Planning is meant for codex once its login works; both
# default to claude until then.
# OMNIGENT_PLAN_EXECUTOR=claude
# OMNIGENT_IMPL_EXECUTOR=claude

# ── Visual plan viewer (self-hosted Plan app + proxy + tunnel) ──────────────
# Planning writes a visual-plan MDX folder per issue (local-files privacy
# mode). A self-hosted Agent-Native Plan app (scaffolded with
# `npx @agent-native/core create plan-app --standalone --template plan`, run
# with PLAN_LOCAL_DIR=<plans dir> HOST=127.0.0.1 PORT=8096 pnpm start) renders
# them at /local-plans/<slug>. The bot's bridge port fronts it with a
# token→cookie auth hop (/plan-auth) so the cloudflared quick tunnel can be
# public; the approval card's "Open the full visual plan" link goes through
# that hop. Run scripts/start-plan-tunnel.sh on the box; it writes the current
# public URL to the tunnel-url file below.
# Where per-issue plan folders are written (must match the planning prompt).
# OPENTAG_PLANS_DIR=/home/omni/plans
# Local port the bridge/proxy listens on (cloudflared points here). Set
# OPENTAG_PLAN_BRIDGE=0 to disable the server entirely.
# OPENTAG_PLAN_BRIDGE_PORT=8791
# Where the self-hosted Plan app listens (loopback).
# OPENTAG_PLAN_APP_PORT=8096
# File the tunnel script writes its current https URL to.
# OPENTAG_TUNNEL_URL_FILE=~/.opentag/tunnel-url
# Or skip the file and pin the public bridge origin (stable/named tunnel).
# OPENTAG_PUBLIC_BRIDGE_URL=
# Set to 1 to route NEW plan-page comments into the Slack revision loop (off
# by default — the plan page is a self-contained local editor).
# OPENTAG_PLAN_PAGE_FEEDBACK=

# ── Discord credentials (from discord.com/developers/applications → your app) ──
# Set both to run on Discord; leave blank to skip Discord. Bot page → "Reset
# Token"; under "Privileged Gateway Intents" enable BOTH Message Content and
# Server Members (both required). Application ID is on General Information.
# DISCORD_BOT_TOKEN=
# DISCORD_APP_ID=
# Optional: a guild (server) id registers slash commands instantly during dev
# (global commands can take up to ~1h). Omit in production.
# DISCORD_GUILD_ID=

# ── Telegram credentials (from @BotFather on Telegram) ──────────────────
# Set to run on Telegram; leave blank to skip Telegram. Message @BotFather →
# /newbot → copy the token it gives you. Long-polling is the default ingress
# (no public URL or webhook setup needed).
# TELEGRAM_BOT_TOKEN=

# ╔═══════════════════════════════════════════════════════════════════════╗
# ║ LEGACY AG-UI MODE (optional) — the original LLM-triage backend.        ║
# ║ Everything below is OFF by default. Set AGENT_URL to ALSO run the      ║
# ║ triage agent (runtime.ts): @mentions still use Omnigent, but slash     ║
# ║ commands + modal submits route to this AG-UI backend (Linear/Notion,   ║
# ║ generative-UI cards, the confirm_write human-in-the-loop gate). Leave  ║
# ║ AGENT_URL unset to run Omnigent-only.                                  ║
# ╚═══════════════════════════════════════════════════════════════════════╝

# ── Agent backend (runtime.ts) ──────────────────────────────────────────
# The AG-UI endpoint the bridge POSTs to. Point at the local CopilotKit
# runtime started by `bun run runtime`. UNSET = Omnigent-only (recommended).
# AGENT_URL=http://localhost:8200/api/copilotkit/agent/triage/run
# Optional auth header forwarded to the agent (for a deployed runtime).
# AGENT_AUTH_HEADER=Bearer ...

# Model for the BuiltInAgent. provider/model — the runtime resolves the
# provider and reads the matching API key below. Defaults to openai/gpt-5.5.
# AGENT_MODEL=anthropic/claude-sonnet-4.5
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ── Linear MCP (legacy AG-UI mode) ──────────────────────────────────────
# The hosted Linear MCP accepts a raw API key as a bearer token (no OAuth
# dance). Create one at linear.app → Settings → API → Personal API keys.
# Leave LINEAR_API_KEY blank/unset to run without Linear.
# LINEAR_API_KEY=lin_api_...
# Override only if you front the MCP yourself; default is the hosted server.
# LINEAR_MCP_URL=https://mcp.linear.app/mcp
# Default Linear team the bot files/queries against.
# LINEAR_TEAM_KEY=CPK

# ── Notion MCP (legacy AG-UI mode) ──────────────────────────────────────
# Run the official Notion MCP as a Streamable-HTTP sidecar: `pnpm notion-mcp`.
# NOTION_TOKEN is the Notion integration secret the sidecar uses to call the
# Notion API (notion.so → Settings → Connections → develop integrations).
# NOTION_MCP_AUTH_TOKEN is the bearer the sidecar requires on its HTTP
# transport; the agent sends it. Pick any strong string and use it in both
# `pnpm notion-mcp` and here. Leave NOTION_MCP_AUTH_TOKEN blank to run
# without Notion.
# NOTION_TOKEN=ntn_...
# NOTION_MCP_AUTH_TOKEN=choose-a-strong-shared-secret
# Override only if the sidecar runs elsewhere; default is the local sidecar.
# NOTION_MCP_URL=http://127.0.0.1:3001/mcp

# ── WhatsApp Cloud API (optional — omit to run Slack-only) ──────────────
# From your Meta App → WhatsApp → API Setup. Leave WHATSAPP_ACCESS_TOKEN blank
# to disable the WhatsApp adapter entirely. Use a System User token in prod
# (the temporary token expires in 24h).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-paste-it-in-the-webhook-config
# Webhook path (default /webhook). The server listens on $PORT — Railway injects
# it and routes the service's public domain there; locally it defaults to 3000.
# WHATSAPP_PATH=/webhook
